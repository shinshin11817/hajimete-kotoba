{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hajimete-kotoba",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hajimete-kotoba-db",
      "database_id": "56852eb0-090c-4521-8589-4bb61530976e"
    }
  ]
}
